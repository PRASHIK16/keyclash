# ==============================================================================
# KEYCLASH — ENVIRONMENT CONFIGURATION
# Copy this file to apps/web/.env.local
# All values come from your Supabase project: Settings -> API
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Service role key — SERVER-SIDE ONLY, never exposed to the browser.
# Used by API routes that must bypass Row Level Security (rating updates,
# match validation). Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY="eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

NEXT_PUBLIC_APP_URL="http://localhost:3000"
